{
  "name": "office-werkstatt-desktop",
  "productName": "Office Werkstatt",
  "version": "1.5.1",
  "description": "Office Werkstatt desktop app (Windows, macOS, Linux) – works without internet",
  "main": "main.js",
  "author": "smyrna-pergamum",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "node build/win-pack.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:win:nsis-builder": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "resedit": "^3.1.1"
  },
  "build": {
    "appId": "org.smyrna-pergamum.officewerkstatt",
    "productName": "Office Werkstatt",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "print-preload.js",
      "print-preview.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../public",
        "to": "app/public"
      },
      {
        "from": "../server",
        "to": "app/server"
      },
      {
        "from": "build/llm",
        "to": "llm"
      }
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word document",
        "description": "Word Werkzeug document",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "xlsx",
        "name": "Spreadsheet",
        "description": "Excel Werkzeug spreadsheet",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "pptx",
        "name": "Presentation",
        "description": "Slide Werkzeug presentation",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "pdf",
        "name": "PDF document",
        "description": "PDF Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "csv",
        "name": "CSV table",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "excalidraw",
        "name": "Drawing",
        "description": "Draw Werkzeug drawing",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "owdoc",
        "name": "Office Werkstatt file",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "doc",
        "name": "Word 97-2003 document",
        "description": "Word Werkzeug document",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "xls",
        "name": "Excel 97-2003 workbook",
        "description": "Excel Werkzeug spreadsheet",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "ppt",
        "name": "PowerPoint 97-2003 presentation",
        "description": "Slide Werkzeug presentation",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "docm",
        "name": "Word macro document",
        "description": "Word Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "dotx",
        "name": "Word template",
        "description": "Word Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "odt",
        "name": "OpenDocument text",
        "description": "Word Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "rtf",
        "name": "Rich Text",
        "description": "Word Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "xlsm",
        "name": "Excel macro workbook",
        "description": "Excel Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "xlsb",
        "name": "Excel binary workbook",
        "description": "Excel Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "ods",
        "name": "OpenDocument spreadsheet",
        "description": "Excel Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "ppsx",
        "name": "PowerPoint show",
        "description": "Slide Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "potx",
        "name": "PowerPoint template",
        "description": "Slide Werkzeug",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "werkzeug",
        "name": "Office Werkstatt file",
        "description": "Office Werkstatt",
        "role": "Editor",
        "icon": "build/icon"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Office Werkstatt",
      "artifactName": "Office-Werkstatt-Setup-${version}.exe",
      "installerLanguages": [
        "de_DE",
        "tr_TR",
        "en_US",
        "es_ES",
        "fr_FR"
      ],
      "multiLanguageInstaller": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/pdf"
      ]
    },
    "compression": "maximum"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smyrna-pergamum/office-werkstatt.git"
  },
  "homepage": "https://github.com/smyrna-pergamum/office-werkstatt"
}
