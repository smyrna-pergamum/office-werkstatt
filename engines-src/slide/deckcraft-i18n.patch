diff --git a/apps/deckcraft-web/src/i18n.rs b/apps/deckcraft-web/src/i18n.rs
new file mode 100644
index 0000000..33d60f7
--- /dev/null
+++ b/apps/deckcraft-web/src/i18n.rs
@@ -0,0 +1,104 @@
+//! Office Werkstatt: the interface in the browser's language.
+//!
+//! The catalogs come from storytold/craft-i18n (`common.tsv` plus DeckCraft's own rows, which win).
+//! They are handed to the text layout, which shows each known English interface text translated.
+
+const CATALOGS: &[(&str, &str, &str)] = &[
+    ("de", include_str!("../i18n/de/common.tsv"), include_str!("../i18n/de/deckcraft.tsv")),
+    ("fr", include_str!("../i18n/fr/common.tsv"), include_str!("../i18n/fr/deckcraft.tsv")),
+    ("es", include_str!("../i18n/es/common.tsv"), include_str!("../i18n/es/deckcraft.tsv")),
+    ("tr", include_str!("../i18n/tr/common.tsv"), include_str!("../i18n/tr/deckcraft.tsv")),
+];
+
+fn unescape(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    let mut it = s.chars();
+    while let Some(c) = it.next() {
+        if c == '\\' {
+            match it.next() {
+                Some('n') => out.push('\n'),
+                Some('t') => out.push('\t'),
+                Some('\\') => out.push('\\'),
+                Some(o) => {
+                    out.push('\\');
+                    out.push(o);
+                }
+                None => out.push('\\'),
+            }
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
+
+/// Rows of one catalog: (context, English, translation), plural and id rows left out.
+fn rows(tsv: &str) -> impl Iterator<Item = (&str, String, String)> {
+    tsv.lines().filter(|l| !l.starts_with('#') && !l.trim().is_empty()).filter_map(|l| {
+        let mut cols = l.split('\t');
+        let ctx = cols.next()?;
+        let en = cols.next()?;
+        let tr = cols.next()?;
+        if ctx.starts_with('@') {
+            return None;
+        }
+        Some((ctx, unescape(en), unescape(tr)))
+    })
+}
+
+/// The browser's first language that has a catalog.
+fn language() -> Option<&'static str> {
+    let nav = web_sys::window()?.navigator();
+    let mut tags: Vec<String> = nav.languages().iter().filter_map(|v| v.as_string()).collect();
+    if let Some(l) = nav.language() {
+        tags.push(l);
+    }
+    for tag in tags {
+        let primary = tag.split(['-', '_']).next().unwrap_or("").to_ascii_lowercase();
+        if primary == "en" {
+            return None;
+        }
+        if let Some((code, ..)) = CATALOGS.iter().find(|(c, ..)| *c == primary) {
+            return Some(code);
+        }
+    }
+    None
+}
+
+/// Installs the translations for the browser's language (nothing for English).
+pub fn install() {
+    let Some(code) = language() else { return };
+    let Some((_, common, app)) = CATALOGS.iter().find(|(c, ..)| *c == code) else { return };
+    let mut map: std::collections::HashMap<String, String> = std::collections::HashMap::new();
+    // context-free rows first, then labelled ones only where the English is still free;
+    // the app's own catalog overrides the shared one
+    for tsv in [common, app] {
+        let all: Vec<_> = rows(tsv).collect();
+        for (ctx, en, tr) in &all {
+            if ctx.is_empty() {
+                map.insert(en.clone(), tr.clone());
+            }
+        }
+        for (ctx, en, tr) in all {
+            if !ctx.is_empty() {
+                map.entry(en).or_insert(tr);
+            }
+        }
+    }
+    // ribbon labels are drawn one line at a time: "New\nSlide" also gives "New" and "Slide"
+    let lines: Vec<(String, String)> = map
+        .iter()
+        .filter(|(en, _)| en.contains('\n'))
+        .flat_map(|(en, tr)| {
+            let (a, b): (Vec<&str>, Vec<&str>) = (en.split('\n').collect(), tr.split('\n').collect());
+            if a.len() == b.len() { a.into_iter().zip(b).map(|(x, y)| (x.trim().to_owned(), y.trim().to_owned())).collect() } else { Vec::new() }
+        })
+        .collect();
+    for (en, tr) in lines {
+        if !en.is_empty() {
+            map.entry(en).or_insert(tr);
+        }
+    }
+    log::info!("interface language {code}: {} texts", map.len());
+    egui::epaint::text::translate::set_translations(map);
+}
